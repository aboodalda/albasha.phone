rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function admin(){ return request.auth != null && request.auth.token.email == "ضع_ايميل_المدير@example.com"; }
    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','branch','method','addr','note','items','total','status','at']) && request.resource.data.total is number && request.resource.data.items.size() <= 50;
      allow read, update, delete: if admin();
    }
  }
}
