rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function admin(){ return request.auth != null && request.auth.token.email == "abd14ab14@gmail.com"; }
    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /repairs/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','branch','device','issue','status','at']);
      allow read, update, delete: if admin();
    }
    match /visits/{d} {
      allow read: if admin();
      allow create: if d.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
    match /settings/{d} { allow read: if true; allow write: if admin(); }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','branch','method','addr','note','items','total','status','at']) && request.resource.data.total is number && request.resource.data.items.size() <= 50;
      allow read, update, delete: if admin();
    }
  }
}
